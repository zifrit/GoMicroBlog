FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/api ./services/api

FROM alpine:3.23
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 microblog
WORKDIR /app
COPY --from=build /out/api /app/api
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/app/api"]
