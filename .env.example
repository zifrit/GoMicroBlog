POSTGRES_DB=microblog
POSTGRES_USER=microblog
POSTGRES_PASSWORD=microblog
DATABASE_URL=postgres://microblog:microblog@db:5432/microblog?sslmode=disable

HTTP_ADDR=:8080
ENGAGEMENT_HTTP_ADDR=:8081
API_PORT=8080
ENGAGEMENT_PORT=8081
DB_PORT=5432
KAFKA_PORT=9092
PGADMIN_PORT=5050

# Compose uses kafka:9092 inside Docker; local Go processes use localhost:9092.
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=microblog.events
KAFKA_GROUP_ID=engagement-stats-v1
OUTBOX_POLL_INTERVAL=250ms
KAFKA_RETRY_INITIAL=1s
KAFKA_RETRY_MAX=30s
OUTBOX_BACKLOG_LOG_INTERVAL=30s

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-local
